PORT=5000

# MongoDB Atlas Connection String
# 1. Create a free cluster on cloud.mongodb.com
# 2. Add a database user in "Database Access"
# 3. Whitelist your IP (or 0.0.0.0/0) in "Network Access"
# 4. Copy the connection string from "Connect" -> "Drivers"
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskmanager?retryWrites=true&w=majority
